# ── Bắt buộc ───────────────────────────────────────────────
# Lấy tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# Backend NestJS (đã gồm prefix /api/v1, không có dấu / ở cuối)
BACKEND_API_URL=http://localhost:3000/api/v1

# ── Tùy chọn ───────────────────────────────────────────────
PORT=3002
GEMINI_MODEL=gemini-3.5-flash-lite
# Model dự phòng khi model chính lỗi (quota riêng theo từng model ở gói miễn phí). Để trống = không dùng
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Origin của frontend được phép gọi agent, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3001
# Trùng INTERNAL_SERVICE_TOKEN của backend (agent gọi backend thay cho nhiều khách)
BACKEND_INTERNAL_TOKEN=dev-internal-token-change-me
# Cùng JWT_ACCESS_SECRET của backend để agent tự kiểm tra chữ ký token (để trống: backend vẫn kiểm tra)
JWT_SECRET=
# Lưu hội thoại vào Postgres (schema agent_memory). Để trống = lưu trong RAM
AGENT_DATABASE_URL=postgres://cinema_admin:cinema_password@localhost:5433/cinema_db
# Chốt chặn chỉ giữ ghế khách đã chọn (chỉ đặt off khi làm thí nghiệm)
SEAT_CHOICE_GUARD=on
RATE_LIMIT_PER_MINUTE=20
BACKEND_TIMEOUT_MS=10000
