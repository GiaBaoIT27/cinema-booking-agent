# Điện thoại KHÔNG truy cập được localhost của máy tính: dùng IP LAN của máy chạy backend
# (xem bằng ipconfig / ifconfig). Đổi xong chạy `npx expo start -c`.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
EXPO_PUBLIC_AGENT_URL=http://192.168.1.10:3002
# Tùy chọn: deep link để trình duyệt tự đóng sau thanh toán VNPay
# (Expo Go: exp://<IP>:8081/--/booking/result; bản build: cinemamobile://booking/result)
EXPO_PUBLIC_PAYMENT_RETURN_URL=
