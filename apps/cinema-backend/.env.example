# Cấu hình Máy chủ & Port Ứng dụng
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Cấu hình Kết nối PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cinema_admin
DB_PASSWORD=cinema_password
DB_NAME=cinema_db

# Cấu hình JWT
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES=7d

# Cấu hình Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cấu hình Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Bảo mật & vận hành (bắt buộc kiểm tra khi NODE_ENV=production, xem docs/08-runbooks/production-deploy.md) ---
# Danh sách origin được gọi API, phân cách bằng dấu phẩy. Trống = cho phép mọi origin (chỉ dev)
CORS_ORIGINS=
# Số reverse proxy đứng trước backend (để rate limit lấy đúng IP client). Trống = không có proxy
TRUST_PROXY=
# Giới hạn request mặc định mỗi phút mỗi IP
THROTTLE_LIMIT_PER_MINUTE=120
# Token dịch vụ nội bộ: agent gửi kèm để không bị rate limit theo IP (production: >= 32 ký tự ngẫu nhiên)
INTERNAL_SERVICE_TOKEN=
# Production tự chạy migration khi khởi động; đặt false nếu pipeline chạy `npm run migration:run` riêng
DB_RUN_MIGRATIONS=

# --- VNPay (production: secret thật, URL https) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3000/api/v1/payments/vnpay/ipn


# --- Notifications ---
APP_BRAND_NAME=Cinema
WEB_BASE_URL=http://localhost:3001
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Cinema <no-reply@cinema.local>"