# Cấu hình Máy chủ & Port Ứng dụng
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Cấu hình Kết nối PostgreSQL thực tế trên máy bạn
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cinema_admin
DB_PASSWORD=cinema_password
DB_NAME=cinema_db

# Cấu hình Mật mã JWT bí mật
JWT_ACCESS_SECRET=super_secret_access_key_enterprise_2026
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_SECRET=super_secret_refresh_key_enterprise_2026
JWT_REFRESH_EXPIRES=7d

# Cấu hình Cơ sở dữ liệu tạm thời Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
